// MadriZuban Test 2: agar / warna (if / else)
// Tests: conditional branching, comparison operators

int marks = 75;

agar (marks >= 80) {
    arzkro marks;
} warna {
    arzkro marks;
}

// Nested condition
int x = 100;
int y = 50;

agar (x > y) {
    int big = x * 2;
    arzkro big;
} warna {
    int small = y * 2;
    arzkro small;
}

// Equality check
int age = 18;
agar (age == 18) {
    arzkro age;
}
